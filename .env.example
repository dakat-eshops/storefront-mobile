# =====================================================================
# KhanhStore Mobile — Public env vars (EXPO_PUBLIC_*)
# Copy to .env.local and fill in actual values for development.
# =====================================================================
#
# RULE: Anything bundled into the mobile app MUST be EXPO_PUBLIC_* and
# safe for public exposure. Mobile is a public client — there is no
# secure place to store secrets in the binary.
#
# FORBIDDEN — these MUST NEVER appear in mobile env (server-only):
#   - FO_HMAC_SECRET           (FO Next.js → NestJS HMAC)
#   - INTERNAL_API_KEY         (BO ↔ NestJS shared key)
#   - SUPABASE_SECRET_KEY      (service role)
#   - CLERK_SECRET_KEY         (server SDK)
#   - ELECTRIC_SHAPE_SECRET    (HMAC for shape URL signing)
#   - INTERNAL_BO_WEBHOOK_SECRET
#
# Mobile authenticates to NestJS /fo-mobile/* via:
#   1. Clerk session JWT (Authorization: Bearer ...)
#   2. Per-request App Attest / Play Integrity attestation token
# =====================================================================

# NestJS API base URL (no trailing slash). Same NestJS instance as web FO.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_VERSION=2026-01

# The store this build targets (multi-tenant scoping).
EXPO_PUBLIC_DEFAULT_STORE_ID=

# Clerk — publishable key only.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase — anon key only (RLS-gated).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud project number for Play Integrity API (Android only).
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# App version — used as MMKV cache buster + sent in attestation requests.
EXPO_PUBLIC_APP_VERSION=1.0.0
